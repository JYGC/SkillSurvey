{
  "Steps": [
    {
      "Name": "install-frontend-dependencies",
      "WorkingDirectory": "frontend",
      "Command": ["npm", "ci", "--no-audit", "--no-fund"]
    },
    {
      "Name": "build-pocketbaseserver",
      "WorkingDirectory": "pocketbaseserver",
      "Command": ["make", "build"]
    },
    {
      "Name": "build-runtask",
      "WorkingDirectory": "runtask",
      "Command": ["make", "build"]
    },
    {
      "Name": "build-frontend",
      "WorkingDirectory": "frontend",
      "Command": ["npm", "run", "build"],
      "DependsOn": ["install-frontend-dependencies"]
    },
    {
      "Name": "go-tests",
      "WorkingDirectory": ".",
      "Command": ["go", "test", "-count=1", "./pocketbaseserver/...", "./runtask/..."],
      "DependsOn": ["build-pocketbaseserver", "build-runtask"],
      "RepeatOnceOnFailure": true
    },
    {
      "Name": "deploy-tests",
      "WorkingDirectory": ".",
      "Command": ["go", "test", "-count=1", "./deploy/..."]
    },
    {
      "Name": "vitest-unit",
      "WorkingDirectory": "frontend",
      "Command": ["npm", "run", "test:unit"],
      "DependsOn": ["install-frontend-dependencies", "build-pocketbaseserver", "build-runtask", "build-frontend", "go-tests"]
    },
    {
      "Name": "vitest-contract",
      "WorkingDirectory": "frontend",
      "Command": ["npm", "run", "test:contract"],
      "DependsOn": ["install-frontend-dependencies", "build-pocketbaseserver", "build-runtask", "build-frontend", "go-tests"]
    },
    {
      "Name": "vitest-integration",
      "WorkingDirectory": "frontend",
      "Command": ["npm", "run", "test:integration"],
      "DependsOn": ["install-frontend-dependencies", "build-pocketbaseserver", "build-runtask", "build-frontend", "go-tests"]
    },
    {
      "Name": "eslint",
      "WorkingDirectory": "frontend",
      "Command": ["npx", "eslint", "."],
      "DependsOn": ["install-frontend-dependencies", "build-pocketbaseserver", "build-runtask", "build-frontend", "go-tests"]
    },
    {
      "Name": "build-frontend-for-e2e",
      "WorkingDirectory": "frontend",
      "Command": ["npm", "run", "build:e2e"],
      "DependsOn": ["vitest-unit", "vitest-contract", "vitest-integration", "eslint"]
    },
    {
      "Name": "e2e-tests",
      "WorkingDirectory": "frontend",
      "Command": ["npm", "run", "test:e2e"],
      "DependsOn": ["build-frontend-for-e2e"]
    },
    {
      "Name": "build-bundles",
      "WorkingDirectory": ".",
      "Command": ["sh", "deploy/build-bundles.sh"],
      "DependsOn": ["e2e-tests", "deploy-tests"]
    }
  ]
}
